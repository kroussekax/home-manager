[
	{
		"include": [
			"Modules.jsonc"
		],

		"layer": "top",
		"exclusive": true,
		"passthrough": false,
		"position": "top",
		"spacing": 0,
		"fixed-center": true,
		"ipc": true,
		"margin-top": 10,
		"margin-left": 30,
		"margin-right": 30,

		"modules-left": [
			"custom/wsprev",
			"hyprland/workspaces",
			"custom/wsnext",
			"cava"
		],

		"modules-center": [
			"clock",
			"custom/dot",
			"hyprland/window",
			"custom/dot",
			"custom/media"
		],

		"modules-right": [
			"tray",
			"custom/dot",
			"bluetooth",
			"network",
			"custom/dot",
			"pulseaudio",
			"battery",
			"custom/notifications"
		]
	}
]
	
